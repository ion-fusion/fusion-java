set -o errexit  # Exit if any statement returns a non-true return value.
set -o nounset  # Exit if any uninitialized variable is used.
set -o pipefail # Exit if commands fail as part of a pipeline.
#set -o xtrace   # Print a trace of the commands being executed.


timestamp=$(date "+%m%d%H%M")

resultsDir=tmp/benchmarks

substring=
tag=
commits=

jmh_args=
jmh_args_q="-f 1 -wi 1 -w 1s -i 1 -r 1s"

function usage()
{
    echo
    echo "Usage: . run-benchmarks [-h] [-q] [-s STRING] [-t TAG] [-c COMMIT] [JMH-ARG] ..."
    echo
    echo "Run benchmarks for each FusionJava COMMIT."
    echo
    echo "-s Substring to match among benchmarks. Equivalent to '.*STRING.*'."
    echo
    echo "-t Tag to use in the name of the results files"
    echo
    echo "-c Identifies a commit of this package to check out and build before running"
    echo "   the benchmarks."
    echo "   Multiple [-c COMMIT] occurrences are allowed."
    echo
    echo "-q Runs benchmarks quickly to ensure they run to completion."
    echo "   Equivalent to: $jmh_args_q"
    echo
    echo "-H Show help for JMH. (This runs Gradle.)"
    echo
    echo
    echo "Benchmark results are copied into $resultsDir"
    echo "The file names include the current time, the given tag, and the commit id."
    echo "If more than one commit is requested, then an index is included such that the"
    echo "files sort in the order they were listed."
    exit
}


function jmh_usage()
{
    ./gradlew --rerun-tasks :benchmarks:jmh -PjmhArgs=-h
    exit
}


function parse_args()
{
  # Don't pollute global namespace when using getopts
  local o OPTARG OPTIND OPTERR
  local args=

  while getopts ":c:s:t:qhH" o; do
    case "$o" in
      h) usage;;
      H) jmh_usage;;
      c) commits="${commits:-} $OPTARG";;
      s) substring=$OPTARG;;
      t) tag=$OPTARG;;
      q) args="$jmh_args_q";;
      *) args="$args -$OPTARG"; break;; # Other arguments are passed through to JMH
    esac
  done
  shift $((OPTIND-1))

  jmh_args="$jmh_args $args $*"
}


function run_bench()
{
  local index=${1:-}   # If given, ensures files sort as they appear on the CLI.

  if [[ -n $substring ]];
  then
      : "${tag:=$substring}"
      jmh_args=".*${substring}.* $jmh_args"
  fi

  local infix=${index:+-$index}${tag:+-$tag}  # That is, [-index][-tag] when each exists

  local commit  #  Separate assignment to avoid hiding errors
  commit=$(current_revision)

  ./gradlew "-PjmhArgs=$jmh_args" ":benchmarks:jmh"

  mkdir -p "$resultsDir"
  local resultsFile=$resultsDir/$timestamp$infix-$commit.json
  cp benchmarks/build/reports/jmh/jmh.json "$resultsFile"

  echo
  echo "Results are at $resultsFile"
}


#=======================================================================================


vcs=git
jj_ws_root=$(jj workspace root) && vcs=jj

function current_revision()
{
    current_revision_$vcs
}

function current_revision_jj
{
    jj log --revision @ --no-graph --template 'self.change_id().shortest(4)'
}

function current_revision_git
{
    git log -n1 --format=%h
}


function checkout()
{
    checkout_$vcs "$@"
}

function checkout_jj
{
    jj edit $1
}

function checkout_git
{
    git checkout $1
}


#=======================================================================================


function run_current()
{
  echo "Running benchmarks using current commit $(current_revision)"
  echo
  run_bench
}


# Used in file names so they sort in the order given on the command line.
commit_index=0

function run_commit()
{
  local commit=$1
  commit_index=$(( commit_index + 1 ))

  echo "==============================================================================="
  echo "Checking out commit $commit"
  checkout "$commit"

  echo
  echo "Cleaning workspace"
  ./gradlew clean

  echo
  echo "Running benchmarks"
  run_bench $commit_index
}


#=======================================================================================

parse_args "$@"


if [[ -z $commits ]];
then
  run_current
else
  # TODO validate the commits before doing anything, so we don't fail mid-run.
  for commit in $commits;
  do
    run_commit "$commit"
  done
fi


echo
echo "Benchmark results are:"
ls -1 "$resultsDir/$timestamp"-*.json

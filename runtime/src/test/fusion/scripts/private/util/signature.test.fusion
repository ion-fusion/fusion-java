(require
  "/fusion/experimental/check"
)

(define_check (check_msg_contains exn substring)
  (check string_contains (exn_message exn) substring))


//====================================================================================
// Syntax error handling
// These forms use low-level, unsafe operators, so weak error checking can cause
// crashes when these forms are misused.

// define_signature

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (define_signature)))

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (define_signature sig)))

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (define_signature 12 ())))
  "expected identifier")

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (define_signature sig [])))
  "expected sexp")

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (define_signature sig (1))))
  "expected identifier")

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (define_signature sig () "not id")))
  "expected identifier")


// provide_signature

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (provide_signature)))

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (define_signature sig1 ())
    (define_signature sig2 ())
    (provide_signature sig1 sig2)))

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (provide_signature "not id")))
  "expected identifier")

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (provide_signature foo)))
  "unbound identifier")


// provide_signature_elements

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (provide_signature_elements)))

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (define_signature sig1 ())
    (define_signature sig2 ())
    (provide_signature_elements sig1 sig2)))

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (provide_signature_elements "not id")))
  "expected identifier")

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (provide_signature_elements foo)))
  "unbound identifier")


// require_signature

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (require_signature)))

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (require_signature "/fusion")))

(expect_syntax_error
  (module BadForm "/fusion"
    (require "/fusion/private/util/signature")
    (require_signature "/fusion" sig1 sig2)))

(check_msg_contains
  (expect_syntax_error
    (module BadForm "/fusion"
      (require "/fusion/private/util/signature")
      (require_signature "/fusion" "not id")))
  "expected identifier")


  //====================================================================================

// `provide_signature_elements` does not provide the signature itself
(module SigNotProvided "/fusion"
  (require "/fusion/private/util/signature")
  (define sig_elt1 1)
  (define sig_elt2 2)
  (define_signature private_sig ()
    sig_elt1
    sig_elt2)
  (provide_signature_elements private_sig)
)
(module CheckSigNotProvided "/fusion"
  (require "/fusion/experimental/check")

  (require SigNotProvided)
  (check === sig_elt1 1)
  (check === sig_elt2 2)
  (expect_syntax_error private_sig)
)
(require CheckSigNotProvided)


(module Base "/fusion"
  (require "/fusion/private/util/signature")

  (define base1 1)
  (define base2 "not in signature")
  (define_signature base_sig ()
    base1)

  (provide_signature base_sig)
  (provide base2)
)
(module CheckBase "/fusion"
  (require "/fusion/experimental/check"
           "/fusion/private/util/signature")

  (require_signature Base base_sig)
  (check === 1 base1)
  (expect_syntax_error base2)
)
(require CheckBase)


// Provide a signature without requiring its elements
(module PassBase "/fusion"
  (require "/fusion/private/util/signature"
           (only_in Base base_sig))

  (provide_signature_elements base_sig)

  // We have not imported the signature's elements
  (require "/fusion/experimental/check")
  (expect_syntax_error base1)
)
(module CheckPassBase "/fusion"
  (require "/fusion/experimental/check"
           PassBase)
  (check === 1 base1)
)
(require CheckPassBase)


// Open the base signature into another one
(module Mid "/fusion"
  (require "/fusion/private/util/signature"
           (only_in Base base_sig))

  (define mid "mid")
  (define_signature mid_sig (base_sig)
    mid)
  (provide_signature mid_sig)
)
(module CheckRequiringMid "/fusion"
  (require "/fusion/experimental/check"
           Mid)
  (check === 1 base1)
  (check === "mid" mid)
)
(require CheckRequiringMid)


(module Side "/fusion"
  (require "/fusion/private/util/signature")

  (define side "side")
  (define_signature side_sig () side)
  (provide_signature side_sig)
)


// Multiple "inheritance"
(module Top "/fusion"
  (require "/fusion/private/util/signature")
  (require_signature Side side_sig)
  (require_signature Mid mid_sig)
  (define_signature top_sig (side_sig mid_sig))
  (provide_signature top_sig)
)
(module CheckTop "/fusion"
  (require "/fusion/experimental/check"
           Top)
  (check === 1 base1)
  (check === "mid" mid)
  (check === "side" side)
)


// Test requiring into top-level
(require "/fusion/private/util/signature")
(require_signature "Top" top_sig)          // Check that string works as module path
(check === 1 base1)
(check === "mid" mid)
(check === "side" side)

(require
  "/fusion/eval"
  "/fusion/experimental/check"
  "/fusion/experimental/syntax"
  "/fusion/ffi/java"
  "/testutils"
)

(define ctx (quote_syntax ctx))

(define context_objects
  (sexp ctx
        (quote_syntax "context")
        (quote_syntax null.null)
        (quote_syntax 1234)
        (datum_to_syntax (java_new "java.lang.Object") ctx ctx)
        // TODO #68 collections should also work
        ))

(define syntaxable_values
  (append all_nulls
          truthy_values
          untruthy_values
          (sexp (java_new "java.lang.Object")
                (lambda () null))))


(define_check (check_loc expected actual)
  (check === (syntax_line     expected) (syntax_line     actual))
  (check === (syntax_column   expected) (syntax_column   actual))
//(check === (syntax-position expected) (syntax-position actual))
  (check === (syntax_source   expected) (syntax_source   actual))
  )


(define (datum2stx2datum v ctx)
  (syntax_to_datum (datum_to_syntax v ctx)))


// Verify context application

(for [(d syntaxable_values)]
  (unless (is_collection d)                // TODO #68
    (let [(stx (datum_to_syntax d ctx))]
      // stx should have the top-level context; use it to make a fresh identifier
      (check free_identifier_equal ctx (datum_to_syntax (quote ctx) stx) d))))


// When given a location, datum->syntax uses it for all new syntax objects
// created, not just the outermost one.

(for [(ctx context_objects)]
  (for [(d (quote [(a (b)), [a, [b]]]))]
    (let [(s (datum_to_syntax d ctx ctx))]
      (check_loc ctx s)
      (check_loc ctx (. (syntax_unwrap s) 0))  // a
      (check_loc ctx (. (syntax_unwrap s) 1))  // (b)
      (check_loc ctx (. (syntax_unwrap (. (syntax_unwrap s) 1)) 0))) // b
   (let [(s (datum_to_syntax (quote {a:a, b:{b:b}}) ctx ctx))]
      (check_loc ctx s)
      (check_loc ctx (. (syntax_unwrap s) "a"))  // a
      (check_loc ctx (. (syntax_unwrap s) "b"))  // {b:b}
      (check_loc ctx (. (syntax_unwrap (. (syntax_unwrap s) "b")) "b")))) // b
   (for [(d syntaxable_values)]
    (let [(s (datum_to_syntax d ctx ctx))]
      (check_loc ctx s))))


(define_check (check_syntaxable v ctx)
  (check ident v    (datum2stx2datum       v  ctx))
  (check ident v (. (datum2stx2datum (sexp v) ctx) 0))
  (check ident v (. (datum2stx2datum      [v] ctx) 0))
  (check ident v (. (datum2stx2datum    {f:v} ctx) "f"))
)

(for [(ctx context_objects)]
  // Non-code constants can be wrapped by syntax objects
  (check_syntaxable + ctx)
  (check_syntaxable (void) ctx)
  // Even non-Fusion values
  (check_syntaxable (java_new "java.lang.Object") ctx)
)



// Exiting syntax objects keep their locations.

(define inner1 (quote_syntax inner1))
(define inner2 (datum_to_syntax (quote inner2) ctx)) // no location

(let [(s (datum_to_syntax
           (sexp inner1 (sexp inner2))  // TODO use quasiquote
           ctx
           ctx))]
  (check_loc ctx    s)
  (check_loc inner1 (. (syntax_unwrap s) 0))                        // inner1
  (check_loc ctx    (. (syntax_unwrap s) 1))                        // (inner)
  (check_loc inner2 (. (syntax_unwrap (. (syntax_unwrap s) 1)) 0))) // inner2


(define val "outside_M")

(module M "/fusion"
  (require "/fusion/experimental/syntax")
  (define val "inside_M")
  (define inside_id (quote_syntax inside_id))
  (provide inside_id))
(require M)

(check === "outside_M"
  (eval (datum_to_syntax (quote_syntax val) inside_id)))

(let ((val (quote_syntax val)))
  (check same (datum_to_syntax val inside_id) val))


// Context must be copied eagerly, without replacing existing syntax objects.
(let ((val (quote_syntax val)))
  (check same val
    (syntax_get (datum_to_syntax (sexp 1 val) inside_id) 1)))


// Verify property application

(define prop_key   (java_new "java.lang.Object"))
(define prop_value (java_new "java.lang.Object"))

(define prop_stx (syntax_property (quote_syntax props) prop_key prop_value))
(check_same prop_value (syntax_property prop_stx prop_key))

(for [(d syntaxable_values)]
  (let [(stx (datum_to_syntax d ctx ctx prop_stx))]
    (check_same prop_value (syntax_property stx prop_key))))

(module number "/fusion/private/kernel"

  '''
Operations on numbers (int, decimal, and float).
  '''


  (require "/fusion/private/intrinsic/compare")
  (provide < <= = >= >)

  (require "/fusion/private/intrinsic/number")
  (provide
    +
    -
    *
    /
    ceiling
    decimal
    floor
    int_to_string
    is_decimal
    is_float
    is_int
    random
    string_to_int
  )

)

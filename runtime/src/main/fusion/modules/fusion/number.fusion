(module number "/fusion/private/layer08"

  '''
Operations on numbers (int, decimal, and float).
  '''


  (require
    "/fusion/private/layer08/actual"
  )


  (provide < <= = == === >= >)

  (provide
    +
    -
    *
    /
    ceiling
    decimal
    floor
    int_to_string
    is_actual_decimal
    is_actual_float
    is_actual_int
    is_decimal
    is_float
    is_int
    random
    string_to_int
  )

)

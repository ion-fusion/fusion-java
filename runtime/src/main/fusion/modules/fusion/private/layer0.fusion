(module layer0 "/fusion/private/kernel"
  '''
Internal dialect that only provides intrinsic forms.

This set is lightly curated to stay general purpose and to avoid features that
we should expect to become non-intrinsic.

We plan to add layers over time, building up from intrinsics in reasonable steps so
that library features can be coded at a high level.  We expect that the content of
layers will shift over time, as intrinsic features are added or ported up to Fusion.
  '''

  // Pass-through most bindings from kernel
  (provide
    all_defined_out
    begin
    current_directory
    current_ion_reader
    current_namespace
    current_output_port
    define_syntax
    define_values
    eof
    if
    java_new  // TODO remove after migrating intrinsics
    lambda
    let_values
    letrec
    module
    only_in
    prefix_in
    provide
    quasiquote
    quasisyntax
    quote
    quote_syntax
    rename_in
    rename_out
    require
    set
    unquote
    unsyntax
    '#%top')

  (require "/fusion/private/intrinsic/exception")
  (provide
    call_with_handler
    raise
    raise_argument_error
    raise_arity_error
    raise_contract_error
    raise_result_error
    unsafe_exn_message
  )

  (require "/fusion/private/intrinsic/list")
  (provide
    is_immutable_list
    is_list
    is_mutable_list
    is_stretchy_list
    list
    mutable_list
    stretchy_list
    unsafe_list_add
    unsafe_list_add_m
    unsafe_list_element
    unsafe_list_iterator
    unsafe_list_set
    unsafe_list_size
    unsafe_list_subseq
    unsafe_list_to_immutable_list
  )

  (require "/fusion/private/intrinsic/sequence")
  (provide
    add
    append
    append_m
  )

  (require "/fusion/private/intrinsic/string")
  (provide
    is_string
    string_append
    string_contains
    string_ends_with
    string_is_lower
    string_is_upper
    string_join
    string_replace
    string_split
    string_starts_with
    string_to_lower
    string_to_upper
    string_to_symbol
    symbol_to_string
  )

  (require "/fusion/private/intrinsic/sexp")
  (provide
    is_pair
    is_sexp
    pair
    sexp
    unsafe_pair_head
    unsafe_pair_tail
  )

  (require "/fusion/private/intrinsic/struct")
  (provide
    is_immutable_struct
    is_mutable_struct
    is_struct
    mutable_struct
    mutable_struct_zip
    remove_keys
    remove_keys_m
    retain_keys
    retain_keys_m
    struct
    struct_merge
    struct_merge_m
    struct_zip
    unsafe_struct_has_key
    unsafe_struct_iterator
    unsafe_struct_put
    unsafe_struct_put_m
    unsafe_struct_puts
    unsafe_struct_puts_m
    unsafe_struct_ref
  )

  (require "/fusion/private/intrinsic/syntax")
  (provide
    bound_identifier_equal
    datum_to_syntax
    define_syntax
    expand_once
    free_identifier_equal
    is_identifier
    is_syntax
    quasisyntax
    quote_syntax
    syntax_append
    syntax_column
    syntax_get
    syntax_is_original
    syntax_line
    syntax_property
    syntax_size
    syntax_subseq
    syntax_to_datum
    syntax_track_origin
    syntax_unwrap
    unsyntax
    wrong_syntax
  )

  (require "/fusion/private/intrinsic/void")
  (provide
    is_void
    void
  )


  (provide (all_defined_out))


  (define_values (annotate)
    '''
    (annotate value text ...)

Applies the given annotations to a `value`, returning a (shallow) copy if
necessary to avoid mutating it.  Any annotations on `value` are removed,
so `(annotate value)` effectively de-annotates a value.

The `value` must be annotatable; that is, it must be one of the Ion types.
The `text` arguments must be non-null strings or symbols.

    (annotate 123 "a")              =>  a::123
    (let [(v (quote a::123))]
      (annotate v))                 =>  123
    (let [(anns ["a", (quote b)])]
      (apply annotate 123 anns))    =>  a::b::123

To extract annotations from a value, use
[`annotations`](fusion.html#annotations).
    '''
    (java_new "dev.ionfusion.fusion.AnnotateProc"))


  (define_values (annotations)
    '''
    (annotations value)

Returns a non-null immutable list of symbols containing the user type
annotations on the `value`.

    (annotations 123)                =>  []
    (annotations (quote a::b::123))  =>  [a, b]

To put annotations onto a value, use [`annotate`](fusion.html#annotate).
    '''
    (java_new "dev.ionfusion.fusion.TypeAnnotationsProc"))


  (define_values (apply)
    '''
    (apply proc arg ... sequence)

Calls the given `proc` with arguments that are the (optional) `arg`s prepended
to the elements of `sequence`.  The `proc` is called in tail position.

    (apply + [1, 2])             =>  3
    (apply + 10 11 (sexp 1 2))   =>  24
    '''
    (java_new "dev.ionfusion.fusion.ApplyProc"))


  (define_values (is_blob)
    '''
    (is_blob value)

Determines whether a `value` is of type `blob`, returning `true` or `false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionBlob$IsBlobProc"))


  (define_values (is_bool)
    '''
    (is_bool value)

Determines whether a `value` is of type `bool`, returning `true` or `false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionBool$IsBoolProc"))


  (define_values (is_clob)
    '''
    (is_clob value)

Determines whether a `value` is of type `clob`, returning `true` or `false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionClob$IsClobProc"))


  (define_values (is_null)
     '''
     (is_null value)

Returns `true` when `value` is _any_ Ion null, `false` otherwise.
     '''
     (java_new "dev.ionfusion.fusion.IsNullProc"))


  (define_values (is_null_null)
    '''
    (is_null_null value)

Determines whether a `value` is `null.null`, returning `true` or `false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionNull$IsNullNullProc"))


  (define_values (is_procedure)
    '''
    (is_procedure value)

Returns `true` when `value` is a procedure, `false` otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionProcedure$IsProcedureProc"))


  (define_values (is_symbol)
    '''
    (is_symbol value)

Determines whether a `value` is of type `symbol`, returning `true` or `false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionSymbol$IsSymbolProc"))


  (define_values (not)
    '''
    (not value)

Returns `true` if `value` is untruthy, `false` if `value` is truthy. Truthiness
is as defined by [`if`](fusion/bool.html#if).
    '''
    (java_new "dev.ionfusion.fusion.NotProc"))


  (define_values (size)
    '''
    (size collection)

Returns the number of elements in the `collection`.
The size of `null.list` (_etc._) is zero.  If `collection` is an improper sexp,
an exception is thrown.

**Warning:** Computing the size of an sexp takes linear time, since it must
traverse the linked list of pairs to count elements.
    '''
    (java_new "dev.ionfusion.fusion.FusionCollection$SizeProc"))


  (define_values (values)
    '''
    (values value ...)

Produces [multiple results](fusion/procedure.html#results), returning the zero
or more `value`s. Usually used in conjuction with `let_values` to bind the
results to names.
    '''
    (java_new "dev.ionfusion.fusion.ValuesProc"))
)

(module layer0 "/fusion/private/kernel"
  '''
Internal dialect that only provides intrinsic forms.

This set is lightly curated to stay general purpose and to avoid features that
we should expect to become non-intrinsic.

We plan to add layers over time, building up from intrinsics in reasonable steps so
that library features can be coded at a high level.  We expect that the content of
layers will shift over time, as intrinsic features are added or ported up to Fusion.
  '''

  (require
    "/fusion/private/intrinsic/atoms"
    "/fusion/private/intrinsic/compare"
    "/fusion/private/intrinsic/exception"
    "/fusion/private/intrinsic/io"
    "/fusion/private/intrinsic/list"
    "/fusion/private/intrinsic/lob"
    "/fusion/private/intrinsic/number"
    "/fusion/private/intrinsic/parameter"
    "/fusion/private/intrinsic/procedure"
    "/fusion/private/intrinsic/sequence"
    "/fusion/private/intrinsic/sexp"
    "/fusion/private/intrinsic/string"
    "/fusion/private/intrinsic/struct"
    "/fusion/private/intrinsic/syntax"
    "/fusion/private/intrinsic/timestamp"
    "/fusion/private/util/signature"
  )


  (define_signature 'sig:layer0' ('sig:layer0:timestamp')

    // kernel
    all_defined_out
    begin
    current_directory
    current_ion_reader
    current_namespace
    current_output_port
    define_syntax
    define_values
    eof
    if
    java_new  // TODO remove after migrating intrinsics
    lambda
    let_values
    letrec
    module
    only_in
    prefix_in
    provide
    quasiquote
    quasisyntax
    quote
    quote_syntax
    rename_in
    rename_out
    require
    set
    unquote
    unsyntax
    '#%top'

    // atoms
    annotate
    annotations
    is_bool
    is_null
    is_null_null
    is_void
    not
    void

    // compare
    = == === same ident
    < <= >= >

    // exception
    call_with_handler
    raise
    raise_argument_error
    raise_arity_error
    raise_contract_error
    raise_result_error
    unsafe_exn_message

    // io
    display
    ionize
    is_eof
    read
    write

    // list
    is_immutable_list
    is_list
    is_mutable_list
    is_stretchy_list
    list
    mutable_list
    stretchy_list
    unsafe_list_add
    unsafe_list_add_m
    unsafe_list_element
    unsafe_list_iterator
    unsafe_list_set
    unsafe_list_size
    unsafe_list_subseq
    unsafe_list_to_immutable_list

    // lob
    is_blob
    is_clob
    lob_digest
    unsafe_lob_to_hex

    // number
    + - * /
    ceiling
    decimal
    floor
    int_to_string
    is_int
    is_decimal
    is_float
    random
    string_to_int

    // parameter
    make_parameter
    parameterize

    // procedure
    apply
    is_procedure
    values

    // sequence
    add
    append
    append_m
    size

    // signature
    define_signature
    provide_signature
    provide_signature_elements
    require_signature

    // string
    is_string
    is_symbol
    string_append
    string_contains
    string_ends_with
    string_is_lower
    string_is_upper
    string_join
    string_replace
    string_split
    string_starts_with
    string_to_lower
    string_to_upper
    string_to_symbol
    symbol_to_string

    // sexp
    is_pair
    is_sexp
    pair
    sexp
    unsafe_pair_head
    unsafe_pair_tail

    // struct
    is_immutable_struct
    is_mutable_struct
    is_struct
    mutable_struct
    mutable_struct_zip
    remove_keys
    remove_keys_m
    retain_keys
    retain_keys_m
    struct
    struct_merge
    struct_merge_m
    struct_zip
    unsafe_struct_has_key
    unsafe_struct_iterator
    unsafe_struct_put
    unsafe_struct_put_m
    unsafe_struct_puts
    unsafe_struct_puts_m
    unsafe_struct_ref

    // syntax
    bound_identifier_equal
    datum_to_syntax
    define_syntax
    expand_once
    free_identifier_equal
    is_identifier
    is_syntax
    quasisyntax
    quote_syntax
    syntax_append
    syntax_column
    syntax_is_original
    syntax_line
    syntax_property
    syntax_size
    syntax_source
    syntax_subseq
    syntax_to_datum
    syntax_track_origin
    syntax_unwrap
    unsyntax
    wrong_syntax


  )

  (provide_signature 'sig:layer0')
)

(module struct "/fusion/private/builtins"

  (require
    "/fusion/private/control"
    "/fusion/private/intrinsic/struct")

  (provide
    is_immutable_struct
    is_mutable_struct
    is_struct
    is_struct_field_name
    mutable_struct
    mutable_struct_zip
    remove_keys
    remove_keys_m
    retain_keys
    retain_keys_m
    struct
    struct_merge
    struct_merge_m
    struct_zip
    unsafe_struct_has_key
    unsafe_struct_iterator
    unsafe_struct_put
    unsafe_struct_put_m
    unsafe_struct_puts
    unsafe_struct_puts_m
    unsafe_struct_ref
  )


  (define is_struct_field_name
    (lambda (v)
      (and (or (is_string v) (is_symbol v))
           (not (is_null v)))))
)

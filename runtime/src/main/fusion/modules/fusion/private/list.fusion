(module private_list "/fusion/private/layer08"

  (require
    "/fusion/private/define"
    "/fusion/private/layer08/actual"
  )

  (provide
    add_m
    is_immutable_list
    is_mutable_list
    is_stretchy_list
    is_list
    list
    list_element
    list_set
    mutable_list
    stretchy_list
    unsafe_list_add
    unsafe_list_add_m
    unsafe_list_element
    unsafe_list_set
    unsafe_list_size
    unsafe_list_subseq
    unsafe_list_to_immutable_list
  )


  //==========================================================================
  // Basic element access

  (define (list_element list i)
    '''
Returns the element of `list` at zero-based index `i`.
The `list` must be non-null.
If `i` is out of bounds or not an int, a exception is raised.
    '''
    (unless (is_actual_list list)
      (raise_argument_error "list_element" "actual list" 0 list i))
    (unless (is_actual_int i)
      (raise_argument_error "list_element" "non-null int" 1 list i))
    (when (or (< i 0) (<= (unsafe_list_size list) i))
      (raise_argument_error "list_element" "valid index" 1 list i))
    (unsafe_list_element list i))


  (define (list_set list i value)
    '''
Changes the element of a mutable `list` at zero-based index `i` to hold the `value`.
If `i` is out of bounds or not an int, a exception is raised.
    '''
    (unless (is_mutable_list list)
      (raise_argument_error "list_set" "mutable list" 0 list i value))
    (unless (is_actual_int i)
      (raise_argument_error "list_set" "non-null int" 1 list i value))
    (when (or (< i 0) (<= (unsafe_list_size list) i))
      (raise_argument_error "list_set" "valid index" 1 list i value))
    (unsafe_list_set list i value))


  //==========================================================================
  // Modification

  (define (add_m list element)
    '''
Returns a sequence with all the elements of `list` and the `element`.  The
result sequence is similar to the input, its size is one greater, and it may
share structure with other sequences.  The input sequence may be mutated.

In general, the position of `element` within the result is not specified, but
particular sequence types may do so.

* For stretchy lists, the `element` is added to the end of the input sequence,
  which is then returned.
    '''
    (if (is_list list)
      (unsafe_list_add_m list element)
      (raise_argument_error "add_m" "list" 0 list element)))
)

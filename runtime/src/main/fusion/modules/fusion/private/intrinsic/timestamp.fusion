(module intrinsic_timestamp "/fusion/private/kernel"

  (require "/fusion/private/util/signature")

  (define_signature 'sig:layer0:timestamp' ()
    epoch_millis_to_timestamp
    is_timestamp
    string_to_timestamp
    timestamp
    timestamp_now
    timestamp_to_epoch_millis
    timestamp_to_string
    timestamp_day
    timestamp_hour
    timestamp_minute
    timestamp_month
    timestamp_offset
    timestamp_second
    timestamp_with_offset
    timestamp_year
  )
  (provide_signature 'sig:layer0:timestamp')

  (define_signature 'sig:layer0:unsafe:timestamp' ()
    unsafe_adjust_day
    unsafe_adjust_hour
    unsafe_adjust_minute
    unsafe_adjust_month
    unsafe_adjust_second
    unsafe_adjust_year
  )
  (provide_signature 'sig:layer0:unsafe:timestamp')


  (define_values (epoch_millis_to_timestamp)
    '''
    (epoch_millis_to_timestamp epoch_millis)

Returns a timestamp for the point in time given as the number of milliseconds
since 1970-01-01T00:00Z. The `epoch_millis` may be a decimal or int.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$EpochMillisToTimestampProc"))


  (define_values (is_timestamp)
    '''
    (is_timestamp value)

Determines whether a `value` is of type `timestamp`, returning `true` or
`false`.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$IsTimestampProc"))


  (define_values (string_to_timestamp)
    '''
    (string_to_timestamp string)

Converts a `string` to a timestamp, recognizing (only) Ion formatted data.
Returns `null.timestamp` when given `null.string`.

    (string_to_timestamp null.string)        ==> null.timestamp
    (string_to_timestamp "2013-11-13T")      ==> 2013-11-13
    (string_to_timestamp "null.timestamp")   ==> ERROR
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$StringToTimestampProc"))


  (define_values (timestamp)
    '''
    (timestamp year month? day? hour? minute? second? offset?)

Returns a timestamp representing a specified point in time.

The `year` is required, and other fields can be added in increasing precision.
Acceptable combinations of arguments being present or absent align with the
combinations of fields allowed by [Ion timestamps][ts]. Optional arguments that are
not present are equivalent to being void.

  * When present, `month` must be an actual integer.
  * When present, `day` must be an actual integer and `month` must be present.
  * When either is present, `hour` and `minute` must both be actual integers,
    and `month` and `day` must be present.
  * When present, `second` must be an actual integer or decimal, and all
    preceding arguments must be present.
  * When present, `offset` must be an actual integer denoting the minutes of
    local offset; void denotes the unknown local offset `-00:00`.  The offset
    is ignored when the hour and minutes are not provided.

For example:

    (timestamp 2016)                       ==> 2016T
    (timestamp 2016 7)                     ==> 2016-07T
    (timestamp 2016 7 1)                   ==> 2016-07-01
    (timestamp 2016 7 1 9 5)               ==> 2016-07-01T09:05-00:00
    (timestamp 2016 7 1 9 5 (void) -420)   ==> 2016-07-01T09:05-07:00
    (timestamp 2016 7 1 9 5 6. 0)          ==> 2016-07-01T09:05:06+00:00
    (timestamp 2016 7 1 9 5 6. (void))     ==> 2016-07-01T09:05:06-00:00
    (timestamp 2016 7 1 9 5 6.123)         ==> 2016-07-01T09:05:06.123-00:00

[ts]: https://amzn.github.io/ion-docs/docs/spec.html#timestamp
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampProc"))


  (define_values (timestamp_now)
    '''
    (timestamp_now)

Returns a timestamp representing "now".  At present the local offset is
unspecified, but that may change in the future.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampNowProc"))


  (define_values (timestamp_to_epoch_millis)
    '''
    (timestamp_to_epoch_millis timestamp)

Given a non-null timestamp, returns the same point in time represented as the
number of milliseconds since 1970-01-01T00:00Z.  The result is a decimal.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampToEpochMillisProc"))


  (define_values (timestamp_to_string)
    '''
    (timestamp_to_string timestamp)

Converts a `timestamp` to a string in Ion format.
Returns `null.string` when given `null.timestamp`.

    (timestamp_to_string null.timestamp)   ==> null.string
    (timestamp_to_string 2013-11-13T)      ==> "2013-11-13"
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampToStringProc"))


  (define_values (timestamp_day)
    '''
    (timestamp_day ts)

Returns the day of `ts` in its local time if its precision is `DAY` or finer,
returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampDayProc"))


  (define_values (timestamp_hour)
    '''
    (timestamp_hour ts)

Returns the hour in the day of `ts` in its local time if its precision is `MINUTE` or
finer, returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampHourProc"))


  (define_values (timestamp_minute)
    '''
    (timestamp_minute ts)

Returns the number of minutes past the hour of `ts` in its local time if its precision
is `MINUTE` or finer, returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampMinuteProc"))


  (define_values (timestamp_month)
    '''
    (timestamp_month ts)

Returns the month of `ts` in its local time if its precision is `MONTH` or finer,
returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampMonthProc"))


  (define_values (timestamp_offset)
    '''
    (timestamp_offset ts)

Returns the local offset of `ts` as an integer in minutes if its offset is known,
 returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampOffsetProc"))


  (define_values (timestamp_second)
    '''
    (timestamp_second ts)

Returns the number of seconds past the minute in `ts` in its local time if its precision
 is `SECOND`, returns void otherwise.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampSecondProc"))


  (define_values (timestamp_with_offset)
    '''
    (timestamp_with_offset ts offset)

Returns a timestamp at the same point-in-time as `ts`, but with local offset equal to `offset` minutes.
The returned timestamp may have different time fields to maintain the same point-in-time.
Expects `ts` to have precision `MINUTE` or finer.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampWithOffsetProc"))


  (define_values (timestamp_year)
    '''
    (timestamp_year ts)

Returns the year of `ts` in its local time.
    '''
    (java_new "dev.ionfusion.fusion.FusionTimestamp$TimestampYearProc"))


  (define_values (unsafe_adjust_day)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddDayProc"))

  (define_values (unsafe_adjust_hour)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddHourProc"))

  (define_values (unsafe_adjust_minute)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddMinuteProc"))

  (define_values (unsafe_adjust_month)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddMonthProc"))

  (define_values (unsafe_adjust_second)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddSecondProc"))

  (define_values (unsafe_adjust_year)
    (java_new "dev.ionfusion.fusion.FusionTimestamp$UnsafeTimestampAddYearProc"))
)

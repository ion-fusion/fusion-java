(module experimental_string "/fusion/private/layer0"

  '''
Experimental string operators.

<!-- #61 This comment forces FusionDoc to stop the one-liner here. -->

## WARNING

This module contains unstable, experimental features.
There is **NO SUPPORT** for this module.
  '''

  (require "/fusion/private/intrinsic/string")

  (provide
    string_explode
    string_implode
    string_index_codepoints
    string_size_codepoints
    string_size_utf8
    string_split_noregexp
  )
)
